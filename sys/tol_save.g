; tol_save.g - rewrites 0:/sys/tolerances.g from the current tolerance globals and ranges (after "Change tol")
; Params: S = name of the changed tolerance, V = old value, N = new value. Line in both consoles.
var f = "0:/sys/tolerances.g"
echo >{var.f} "; tolerances.g - all procedure tolerances [mm] in one place. Edit here (DWC) or with Change tol in the windows"
echo >>{var.f} "; (the macro then rewrites this file via tol_save.g). Loaded at the start of every macro that uses them."
echo >>{var.f} "; Ranges xxxR = {recommended min, recommended max, allowed min, allowed max} (see tol_ask.g, tol_check.g)."
echo >>{var.f} "; last change: " ^ state.time ^ " " ^ param.S ^ " " ^ param.V ^ " -> " ^ param.N ^ " (window Change tol)"
echo >>{var.f} "if !exists(global.tolXY)"
echo >>{var.f} "  global tolXY = 0"
echo >>{var.f} "if !exists(global.tolZ)"
echo >>{var.f} "  global tolZ = 0"
echo >>{var.f} "if !exists(global.tolBed)"
echo >>{var.f} "  global tolBed = 0"
echo >>{var.f} "if !exists(global.tolG31Live)"
echo >>{var.f} "  global tolG31Live = 0"
echo >>{var.f} "if !exists(global.tolG31Methods)"
echo >>{var.f} "  global tolG31Methods = 0"
echo >>{var.f} "if !exists(global.tolCheck)"
echo >>{var.f} "  global tolCheck = 0"
echo >>{var.f} "if !exists(global.tolXYR)"
echo >>{var.f} "  global tolXYR = {0, 0, 0, 0}"
echo >>{var.f} "if !exists(global.tolZR)"
echo >>{var.f} "  global tolZR = {0, 0, 0, 0}"
echo >>{var.f} "if !exists(global.tolBedR)"
echo >>{var.f} "  global tolBedR = {0, 0, 0, 0}"
echo >>{var.f} "if !exists(global.tolG31LiveR)"
echo >>{var.f} "  global tolG31LiveR = {0, 0, 0, 0}"
echo >>{var.f} "if !exists(global.tolG31MethodsR)"
echo >>{var.f} "  global tolG31MethodsR = {0, 0, 0, 0}"
echo >>{var.f} "if !exists(global.tolCheckR)"
echo >>{var.f} "  global tolCheckR = {0, 0, 0, 0}"
echo >>{var.f} "set global.tolXY = " ^ global.tolXY ^ "   ; homing check B: X/Y endstop repeatability -> error window (home_xy.g)"
echo >>{var.f} "set global.tolZ = " ^ global.tolZ ^ "   ; homing check C: Z zero shift vs previous homing -> warning (home_sum.g)"
echo >>{var.f} "set global.tolBed = " ^ global.tolBed ^ "   ; G32: deviation before correction counted as level (bed.g)"
echo >>{var.f} "set global.tolG31Live = " ^ global.tolG31Live ^ "   ; HesCal2: new G31 vs last good G31 -> window G31 REJECTED (hescal2_m.g)"
echo >>{var.f} "set global.tolG31Methods = " ^ global.tolG31Methods ^ "   ; HesCal2: G31 from K1 tip vs from bed -> warning (hescal2_m.g)"
echo >>{var.f} "set global.tolCheck = " ^ global.tolCheck ^ "   ; Mesh: check point residual with the map on -> window MESH CHECK (Mesh)"
echo >>{var.f} "set global.tolXYR = {" ^ global.tolXYR[0] ^ ", " ^ global.tolXYR[1] ^ ", " ^ global.tolXYR[2] ^ ", " ^ global.tolXYR[3] ^ "}"
echo >>{var.f} "set global.tolZR = {" ^ global.tolZR[0] ^ ", " ^ global.tolZR[1] ^ ", " ^ global.tolZR[2] ^ ", " ^ global.tolZR[3] ^ "}"
echo >>{var.f} "set global.tolBedR = {" ^ global.tolBedR[0] ^ ", " ^ global.tolBedR[1] ^ ", " ^ global.tolBedR[2] ^ ", " ^ global.tolBedR[3] ^ "}"
echo >>{var.f} "set global.tolG31LiveR = {" ^ global.tolG31LiveR[0] ^ ", " ^ global.tolG31LiveR[1] ^ ", " ^ global.tolG31LiveR[2] ^ ", " ^ global.tolG31LiveR[3] ^ "}"
echo >>{var.f} "set global.tolG31MethodsR = {" ^ global.tolG31MethodsR[0] ^ ", " ^ global.tolG31MethodsR[1] ^ ", " ^ global.tolG31MethodsR[2] ^ ", " ^ global.tolG31MethodsR[3] ^ "}"
echo >>{var.f} "set global.tolCheckR = {" ^ global.tolCheckR[0] ^ ", " ^ global.tolCheckR[1] ^ ", " ^ global.tolCheckR[2] ^ ", " ^ global.tolCheckR[3] ^ "}"
echo >>{var.f} "M98 P""0:/sys/tol_check.g"""   ; RRF: "" inside a string = one quote
M98 P"0:/sys/msg.g" S{param.S ^ " " ^ param.V ^ " -> " ^ param.N ^ " saved"}
